# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# Leave empty locally to keep zero GTM network requests.
# Production builds use .env.production (VELVET container GTM-NZBJHJ8D).
#
# GA4, Clarity, Meta Pixel, etc. are configured inside GTM — not as separate
# frontend scripts/env vars.
VITE_GTM_ID=

# --- iGroup platform content + customer APIs --------------------------------
# The storefront loads its catalog from the iGroup platform when enabled and
# uses the same origin for customer auth, favorites, orders and reviews.
# Local/dev default to the staging API; production overrides via .env.production.
VITE_IGROUP_CONTENT_ENABLED=true
VITE_IGROUP_API_URL=https://api-staging.igroup.website
VITE_IGROUP_COMPANY_ID=kids-velvet
VITE_IGROUP_SITE_ID=kids-velvet-storefront

# Backward-compatible override for the customer auth origin. When set, it wins
# over VITE_IGROUP_API_URL for auth calls only. Leave empty to reuse the
# platform API origin above.
VITE_CUSTOMER_AUTH_API=

# --- Media / analytics setup notes -----------------------------------------
# This storefront pushes a custom dataLayer event named "page_view" on:
#   - initial load
#   - each SPA route / query change
# Payload fields: page_path, page_location, page_title
#
# To avoid duplicate page views in GTM/GA4:
#   1) Prefer triggers based on this custom "page_view" event, OR
#   2) Disable GA4 automatic / enhanced measurement page_view if it would
#      fire in addition to our SPA event.
# Do not enable both for the same navigations.
